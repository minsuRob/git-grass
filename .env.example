# Database
# 로컬 설치: postgresql://USER:PASSWORD@localhost:5432/github_dashboard
# Docker (docker-compose up 후): 아래 주소 사용
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/github_dashboard"

# Better Auth
BETTER_AUTH_SECRET="your-secret-key-here"
BETTER_AUTH_URL="http://localhost:3001"

# GitHub OAuth
GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"
GITHUB_REDIRECT_URI="http://localhost:3001/api/auth/callback/github"
GITHUB_OAUTH_URL="https://github.com/login/oauth/authorize"

# API
API_URL="http://localhost:3001"